# Copy to .env, then replace all three placeholders. Do not commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_CALLS=8
LLM_MAX_MODEL_CALLS=6
LLM_MAX_OUTPUT_TOKENS=2000
GALILEO_ENABLED=true
GALILEO_API_KEY=
GALILEO_PROJECT=splunky-finance
GALILEO_LOG_STREAM=my-bank-agent
# Use URLs supplied by your Galileo deployment. No tenant is assumed.
GALILEO_CONSOLE_URL=
GALILEO_API_URL=
AGENT_CONTROL_URL=
# The agent name registered with Agent Control. Leave blank: the application registers its own,
# derived from the project and stream, so nothing has to be created in advance and a participant has
# nothing to type. Set it only to point at a specific agent that already exists.
AGENT_CONTROL_AGENT_NAME=
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_RUNTIME_TOKEN_HEADER=X-Agent-Control-Runtime-Token
GALILEO_PROTECTION_ENABLED=false
DEMO_SEED=42
DEMO_REFERENCE_DATE=2026-09-15
DEMO_TIMEZONE=Australia/Brisbane
DEMO_ACCOUNT_NUMBER=12345678
# Fixed and shared: every participant in a workshop uses these, and a presenter reads them
# aloud. They are deliberately not random. Anyone who can reach the instance and knows them can
# sign in, so this is for a demo on synthetic data and nothing else.
DEMO_PASSWORD=AlexDemo1234!
DEMO_ADMIN_PASSWORD=PresenterDemo1234!
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
SESSION_COOKIE_SECURE=false
# Trusted LAN HTTP only; public remote access requires HTTPS.
ALLOW_PRIVATE_LAN_HTTP=false
FRONTEND_BIND_ADDRESS=127.0.0.1
# Host port for this stack. Change it to run more than one stack on a machine.
FRONTEND_PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=/app/runtime
POLICY_DIR=/app/data/policies

# Network the image builds use to reach PyPI and npm. Leave as default almost everywhere. Set to
# host on a network that redirects container egress -- the symptom is a dependency download
# failing with a certificate "only valid for" some unrelated name, while curl from the host to the
# same URL succeeds. See docs/workshop.md, "When the image build cannot reach PyPI or npm".
BUILD_NETWORK=default

# Boot-time self-update, read by scripts/selfupdate.py. An instance spun up for a workshop should not
# run whatever code was baked into the AMI weeks earlier.
#   tags   newest v* tag. A tag is a decision someone made (default)
#   branch tip of UPDATE_BRANCH. Whatever was pushed last, including an unfinished commit
#   off    start without updating
UPDATE_CHANNEL=tags
UPDATE_BRANCH=build-splunky-finance
# Seconds to wait for containers to report healthy before rolling back.
UPDATE_TIMEOUT=300
