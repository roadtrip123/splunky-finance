# Re-assert the container egress bypass, shortly after boot and then periodically.
#
# Periodically rather than once, because the rule this works around is inserted by something
# outside this repository, at a time nobody here controls. A single pass at boot loses to a
# redirect inserted a minute later, and the failure is silent until a participant tries to connect
# to Galileo. The check itself is one `iptables -t nat -S PREROUTING`, so running it often costs
# nothing worth measuring.
#
# One minute rather than three: the interval is the window in which a clone shows a connection
# error that reads as a bad API key, and across a hundred participants that window is what gets
# believed. Three minutes of it was the only gap left after v1.1.16.
#
#   systemctl list-timers splunky-finance-egress.timer     when it next runs
#   journalctl -u splunky-finance-egress -f                what each pass decided

[Unit]
Description=Splunky Finance: re-assert the container egress bypass

[Timer]
OnBootSec=45s
OnUnitActiveSec=1min
AccuracySec=5s
Unit=splunky-finance-egress.service

[Install]
WantedBy=timers.target
