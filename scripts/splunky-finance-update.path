# Watch for an update requested from the presenter portal's Troubleshooting tab.
#
#   sudo cp scripts/splunky-finance-update.{path,service} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now splunky-finance-update.path
#
# The backend container cannot run git or Docker and is deliberately not given either: the presenter
# password is published in this repository, so a container holding the Docker socket would mean
# anyone with that password owns the host. Writing one file is the entire capability it has.

[Unit]
Description=Watch for an update requested from the presenter portal

[Path]
PathExists=/home/ubuntu/splunky-finance/runtime/update/request.json
Unit=splunky-finance-update.service

[Install]
WantedBy=multi-user.target
